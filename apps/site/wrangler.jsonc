{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "charon-site",
  "compatibility_date": "2026-08-12",
  "send_metrics": false,
  "dependencies_instrumentation": {
    "enabled": false
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "charon.simonhazard.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": false
  }
}
