---
import { Image } from 'astro:assets';

import charonMark from '../assets/charon-mark.svg';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Charon — local desktop scaffold</title>
  </head>
  <body>
    <main class="smoke-shell">
      <Image src={charonMark} alt="" width={64} height={64} />
      <p class="eyebrow">Static English route</p>
      <h1>Charon</h1>
      <p>The local-only desktop toolchain is ready.</p>
      <a href="/fr/" hreflang="fr">Français</a>
    </main>
  </body>
</html>
