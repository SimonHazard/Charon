---
import { copy, type Locale, routes } from '../content/site';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = copy[locale];
const base = import.meta.env.BASE_URL.replace(/\/$/u, '');
const path = (route: string) => `${base}${route}`;
---

<BaseLayout locale={locale} page="home" title="Charon" description={c.intro}>
  <section class="home section-shell">
    <div class="home-copy">
      <h1>{c.title}</h1>
      <p class="lede">{c.intro}</p>
      <a class="primary-action" href={path(routes[locale].download)}>{c.viewReleases}</a>
    </div>
  </section>
</BaseLayout>
