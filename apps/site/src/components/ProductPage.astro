---
import { copy, type Locale } from '../content/site';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = copy[locale];
---

<BaseLayout locale={locale} page="home" title="Charon" description={c.intro}>
  <section class="home section-shell">
    <div class="home-copy">
      <h1>{c.title}</h1>
      <p class="lede">{c.intro}</p>
    </div>
  </section>
</BaseLayout>
