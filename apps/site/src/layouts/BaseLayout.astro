---
import '../styles/global.css';
import { copy, type Locale, type PageKind, routes } from '../content/site';

interface Props {
  locale: Locale;
  page: PageKind;
  title: string;
  description: string;
}

const { locale, page, title, description } = Astro.props;
const c = copy[locale];
const alternate = locale === 'en' ? 'fr' : 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/u, '');
const path = (route: string) => `${base}${route}` || '/';
const canonical = new URL(path(routes[locale][page]), Astro.site);
const alternateUrl = new URL(path(routes[alternate][page]), Astro.site);
const defaultUrl = new URL(path(routes.en[page]), Astro.site);
const socialImage = new URL(path('/brand/charon-icon-lavender-1024.png'), Astro.site);
---

<!doctype html>
<html lang={locale} data-theme="solarized">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fdf6e3" />

    <link rel="icon" href={path('/brand/charon-icon-lavender-32.png')} sizes="32x32" type="image/png" />
    <link rel="icon" href={path('/brand/charon-icon-lavender-16.png')} sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href={path('/brand/charon-icon-lavender-180.png')} sizes="180x180" />
    <link rel="manifest" href={path('/site.webmanifest')} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={alternate} href={alternateUrl} />
    <link rel="alternate" hreflang="x-default" href={defaultUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Charon" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content="Charon" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">{c.skip}</a>
    <header class="site-header">
      <a class="brand" href={path(routes[locale].home)} aria-label="Charon" translate="no">
        <img
          src={path('/brand/charon-icon-lavender-32.png')}
          width="32"
          height="32"
          alt=""
          aria-hidden="true"
          fetchpriority="high"
        />
        <span>Charon</span>
      </a>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <nav aria-label={c.footerLinks}>
        <ul>
          <li><a href="https://ko-fi.com/simonhazard" translate="no">Ko-fi</a></li>
          <li><a href="https://simonhazard.com/" translate="no">simonhazard.com</a></li>
        </ul>
      </nav>
    </footer>
  </body>
</html>
