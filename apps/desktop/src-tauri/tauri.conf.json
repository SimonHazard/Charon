{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Charon",
  "mainBinaryName": "Charon",
  "version": "0.1.3",
  "identifier": "dev.simonhazard.charon",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Charon",
        "width": 480,
        "height": 720,
        "minWidth": 400,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; form-action 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'; form-action 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "deb", "appimage", "rpm", "nsis", "msi"],
    "category": "Productivity",
    "publisher": "Simon Hazard",
    "copyright": "Copyright © 2026 Simon Hazard",
    "homepage": "https://github.com/SimonHazard/Charon",
    "shortDescription": "Free, local-first capture for agent-ready Markdown.",
    "longDescription": "Charon is a free, local-first capture shelf for turning useful text into ordinary Markdown notes without accounts, telemetry, or content uploads.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "librsvg2-2"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3", "librsvg2"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "French"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/SimonHazard/Charon/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBQjExRENFRTEyRjQ0NzgKUldSNFJDL2h6aDJ4NnBQSDNLNGJZSUlIWFZ4Q29XYzBXV1NIZE9ONWV0M3pKT3NLNWw5M1FZN3oK"
    }
  }
}
