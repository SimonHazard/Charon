{
  "name": "charon",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "bun --cwd apps/desktop run dev",
    "dev:site": "bun --cwd apps/site run dev",
    "preview:site": "bun --cwd apps/site run preview",
    "build:desktop": "bun --cwd apps/desktop run build",
    "build:site": "bun --cwd apps/site run build",
    "test:desktop": "bun --cwd apps/desktop run test",
    "test:site": "bun --cwd apps/site run test",
    "build": "bun run build:desktop && bun run build:site",
    "typecheck": "bun --cwd apps/desktop run typecheck && bun --cwd apps/site run typecheck",
    "test": "bun run test:desktop && bun run test:site",
    "lint": "biome check .",
    "check": "bun run lint && bun run typecheck && bun run test",
    "tauri:dev": "bun --cwd apps/desktop run tauri:dev",
    "tauri:build": "bun --cwd apps/desktop run tauri:build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "typescript": "7.0.2"
  }
}
