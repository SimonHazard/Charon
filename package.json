{
  "name": "charon",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "bun run --cwd apps/desktop dev",
    "dev:site": "bun run --cwd apps/site dev",
    "preview:site": "bun run --cwd apps/site preview",
    "build:desktop": "bun run --cwd apps/desktop build",
    "build:site": "bun run --cwd apps/site build",
    "test:desktop": "bun run --cwd apps/desktop test",
    "test:site": "bun run --cwd apps/site test",
    "build": "bun run build:desktop && bun run build:site",
    "typecheck": "bun run --cwd apps/desktop typecheck && bun run --cwd apps/site typecheck",
    "test": "bun run test:desktop && bun run test:site",
    "lint": "biome check .",
    "check": "bun run lint && bun run typecheck && bun run test",
    "bindings:generate": "bun scripts/check-bindings.ts --write",
    "bindings:check": "bun scripts/check-bindings.ts",
    "tauri:dev": "bun run --cwd apps/desktop tauri:dev",
    "tauri:build": "bun run --cwd apps/desktop tauri:build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "typescript": "7.0.2"
  }
}
