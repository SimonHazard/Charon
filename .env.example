# Canonical public origin used when building the static site.
CHARON_SITE_ORIGIN=https://charon.example

# Optional deployment base path; leave empty for the production root.
CHARON_SITE_BASE=

# Set to 1 only when intentionally running desktop-only Playwright coverage.
CHARON_DESKTOP_ONLY_E2E=0

# CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN belong only in GitHub environment secrets.
